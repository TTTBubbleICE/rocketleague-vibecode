{
  "name": "puck-rocket-mini-arena",
  "productName": "Puck Rocket",
  "version": "1.0.0",
  "description": "3D-Minispiel aus Puck und Rocket League: 1 gegen 1 gegen einen Bot, mit Sprung, Flip und Aerials in einer handgeschriebenen WebGL2-Arena. Das Spiel selbst ist eine einzige HTML-Datei ohne Laufzeit-Abhängigkeiten.",
  "private": true,
  "author": "TTTBubbleICE",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.puckrocket.arena",
    "productName": "Puck Rocket",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "2d-version/**/*",
      "main.js",
      "package.json",
      "README.md",
      "REVERSE-ENGINEERING.md"
    ],
    "asar": false,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Puck Rocket"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "electron",
    "game",
    "minigame",
    "rocket-league",
    "puck",
    "webgl2",
    "3d"
  ]
}
